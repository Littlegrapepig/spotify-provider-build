      - name: Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Android SDK
        uses: android-actions/setup-android@v4
      - name: Android platform
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'
      - name: Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Sort, Last.fm and Compose node-id tests
        run: bash tests/run_sort_test.sh
      - name: Compile APK
        run: gradle --no-daemon --console=plain :app:assembleDebug
      - name: Upload Android APK
        uses: actions/upload-artifact@v4
        with:
          name: Spotify-Lastfm-NativeSort-v0.7.1-APK
          path: app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
      - name: Publish Release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release view native-sort-v071 >/dev/null 2>&1 && gh release upload native-sort-v071 app/build/outputs/apk/debug/app-debug.apk --clobber || gh release create native-sort-v071 app/build/outputs/apk/debug/app-debug.apk --target "$GITHUB_SHA" --title 'Spotify Last.fm Native Sort v0.7.1' --notes 'Fixed Android Compose virtual node decoding and added native Sort menu signature detection.' --prerelease
